{
  "id": "a1-u01",
  "level": "A1",
  "order": 1,
  "kind": "grammar",
  "title": {
    "en": "To be: am / is / are",
    "ua": "Дієслово to be: am / is / are",
    "ru": "Глагол to be: am / is / are"
  },
  "rule": {
    "formula": "I → am · He / She / It → is · We / You / They → are",
    "explain": {
      "ua": "To be означає «бути, є». В українській ми його пропускаємо: «Я вчитель». В англійській він обов'язковий: I am a teacher. Форма залежить від того, про кого йдеться.",
      "ru": "To be означает «быть, являться». В русском мы его пропускаем: «Я учитель». В английском он обязателен: I am a teacher. Форма зависит от того, о ком идёт речь."
    },
    "examples": [
      {
        "en": "I am a student.",
        "ua": "Я студент.",
        "ru": "Я студент."
      },
      {
        "en": "She is from Ukraine.",
        "ua": "Вона з України.",
        "ru": "Она из Украины."
      },
      {
        "en": "They are happy.",
        "ua": "Вони щасливі.",
        "ru": "Они счастливы."
      }
    ],
    "compare": {
      "ua": "Українською: «Він лікар» (без дієслова). Англійською: He IS a doctor — без is речення неправильне.",
      "ru": "По-русски: «Он врач» (без глагола). По-английски: He IS a doctor — без is предложение неправильное."
    }
  },
